# Copy to backend/.env and frontend/.env.local

# --- Backend (backend/.env) ---
APP_NAME=AI Career Coach
APP_ENV=development
# Required outside development: the app refuses to start when APP_ENV is not a
# development value and SECRET_KEY is missing, still the default, or under 32
# characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./career_coach.db

# Bootstrap admin. In development the account is seeded as
# admin@careercoach.app / Admin1234! when ADMIN_PASSWORD is blank.
# Outside development no admin is created unless ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@careercoach.app
ADMIN_PASSWORD=

# Set to false only for local load testing.
RATE_LIMIT_ENABLED=true

# Enable only when the app sits behind a proxy you control (nginx, Fly, Render).
# Rate limiting then keys on X-Forwarded-For instead of the socket peer, so one
# proxy does not put every user in the same bucket. Leave false when the app is
# directly reachable, or clients can spoof the header to dodge the limit.
TRUST_PROXY_HEADERS=false

# OpenAI-compatible LLM (this MVP uses OpenAI)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FAST_MODEL=gpt-4o-mini
LLM_PREMIUM_MODEL=gpt-4o-mini

# Optional extra providers (OpenAI-compatible). Routing uses them by plan/task.
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Stripe — optional. When unset, Pro/Premium use in-app card validation (number is not stored).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# Optional SMTP for password-reset email. Without it, the reset link is written
# to the backend log in development only, and never returned in an API response.
# Outside development a failed send is logged without the link, so configure
# SMTP before deploying or password reset cannot complete.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Supabase Postgres — replace sqlite when you have the URI
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://rgxpxuruuqbwpgtukitr.supabase.co

# Optional: OpenAI embeddings for RAG (falls back to lexical search)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Optional Cloudflare R2 (falls back to local storage/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=career-coach-docs
R2_ENDPOINT=

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
